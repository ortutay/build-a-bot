{
  "name": "@fetchfox/builder",
  "version": "0.1.0",
  "description": "An agent that builds web-data extraction functions.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "web",
    "scraping",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/ --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "scratch": "tsx src/scratch.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@mastra/core": "^1.58.0",
    "@mastra/redis": "^1.4.0",
    "cheerio": "^1.2.0",
    "happy-dom": "^20.8.4",
    "ioredis": "^6.0.0",
    "json-schema-to-ts": "^3.1.1",
    "node-html-parser": "^7.1.0",
    "playwright": "^1.58.2",
    "pretty": "^2.0.0",
    "radash": "^12.1.1",
    "tslog": "^5.1.0",
    "undici": "^7.24.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "eslint": "^9.27.0",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md}": "prettier --write"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
