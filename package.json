{
  "name": "@fetchfox/builder",
  "version": "0.1.0",
  "description": "An agent that builds web-data extraction functions.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "web",
    "scraping",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/copy-public-assets.mjs",
    "test": "ENV=test FORCE_COLOR=1 vitest run --dir test",
    "test:watch": "ENV=test FORCE_COLOR=1 vitest --dir test",
    "eval": "ENV=test FORCE_COLOR=1 DOCUMENT_LIBRARY_PATH=/tmp/builder/evals/documents vitest run --dir evals",
    "unused": "npm run typecheck -- --noUnusedLocals --noUnusedParameters",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepack": "npm run build",
    "scratch": "tsx src/scratch.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.18.2",
    "@mastra/core": "^1.58.0",
    "@mastra/duckdb": "^1.6.2",
    "@mastra/evals": "^1.9.0",
    "@mastra/libsql": "^1.21.1",
    "@mastra/mcp": "^1.16.0",
    "@mastra/observability": "^1.17.1",
    "@mastra/redis": "^1.4.0",
    "chalk": "^6.0.0",
    "cheerio": "^1.2.0",
    "happy-dom": "^20.8.4",
    "ioredis": "^6.0.0",
    "json-schema-to-ts": "^3.1.1",
    "node-html-parser": "^7.1.0",
    "p-queue": "^9.3.3",
    "playwright": "^1.58.2",
    "pretty": "^2.0.0",
    "protobufjs": "^8.7.2",
    "radash": "^12.1.1",
    "tslog": "^5.1.0",
    "undici": "^7.24.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mastra": "^1.26.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.3.0",
    "vitest": "^4.1.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md}": "prettier --write"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
