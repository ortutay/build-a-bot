{
  "name": "@build-a-bot/core",
  "version": "0.1.0",
  "description": "Core Build-A-Bot runtime.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "mastra:build": "mastra build",
    "dev": "tsc --watch",
    "test": "ENV=test FORCE_COLOR=1 vitest run --dir test",
    "test:watch": "ENV=test FORCE_COLOR=1 vitest --dir test",
    "eval": "ENV=test FORCE_COLOR=1 DOCUMENT_LIBRARY_PATH=/tmp/builder/evals/documents vitest run --dir evals",
    "typecheck": "tsc -p tsconfig.test.json",
    "scratch": "tsx src/internal/scratch.ts",
    "create-datasets": "tsx tasks/create-datasets.ts"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.18.2",
    "@mastra/core": "^1.63.0",
    "@mastra/duckdb": "^1.6.2",
    "@mastra/evals": "^1.9.0",
    "@mastra/libsql": "^1.21.1",
    "@mastra/mcp": "^1.17.1",
    "@mastra/observability": "^1.17.1",
    "@mastra/redis": "^1.4.2",
    "chalk": "^6.0.0",
    "cheerio": "^1.2.0",
    "happy-dom": "^20.8.4",
    "ioredis": "^6.0.0",
    "json-schema-to-ts": "^3.1.0",
    "node-html-parser": "^7.1.0",
    "p-queue": "^9.3.3",
    "playwright": "^1.58.2",
    "pretty": "^2.0.0",
    "protobufjs": "^8.7.2",
    "radash": "^12.1.0",
    "tslog": "^5.1.0",
    "undici": "^7.24.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "mastra": "^1.27.0"
  }
}
